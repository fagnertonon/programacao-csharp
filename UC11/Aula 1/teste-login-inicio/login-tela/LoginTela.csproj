<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SistemaLogin</RootNamespace>
    <AssemblyName>PortalDoAluno</AssemblyName>

    <!--
      A TELA do Portal do Aluno - Windows Forms, o mesmo tipo de projeto
      que voces fizeram a UC12 inteira.
      UC11, Aula 1 (08/09/2026).
    -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!--
    A LINHA QUE ESCOLHE O ALVO.

    A tela nao tem uma copia das regras: ela USA o mesmo Cadastro.cs do
    projeto de console. E o mesmo arquivo, em um lugar so.

    Troque "login-defeituoso" por OUTRA PASTA que tenha um Cadastro.cs
    aqui embaixo, e a MESMA tela passa a rodar contra outro codigo, sem
    mudar um pixel do formulario. E a mesma parametrizacao que o projeto
    de teste faz.
  -->
  <ItemGroup>
    <Compile Include="..\login-defeituoso\Cadastro.cs" Link="Cadastro.cs" />
  </ItemGroup>

</Project>
