        "linhas": [
          "funcao Procurar(termo: caractere): inteiro",
          "var recados: vetor de Recado",
          "    quantos: inteiro",
          "inicio",
          "   recados <- MuralDAO.Listar()",
          "   quantos <- 0",
          "",
          "   limpe(lstMural)",
          "",
          "   para cada r em recados faca",
          "      se contem(minusculo(r.Texto), minusculo(termo)) entao",
          "         acrescente(lstMural, Descrever(r))",
          "         quantos <- quantos + 1",
          "      fimse",
          "   fimpara",
          "",
          "   retorne quantos",
          "fimfuncao"
        ]
      },
      "ficha": {
        "recebe": "um texto (string)",
        "faz": "percorre o mural, mostra so os que combinam e conta",
        "devolve": "um numero (int)"
      },
      "csharp": [
        "private {1} Procurar({2} termo)",
        "{",
        "    List<Recado> recados = MuralDAO.Listar();",
        "",
        "    int quantos = {3};",
        "",
        "    lstMural.Items.Clear();",
        "",
        "    foreach (Recado r in recados)",
        "    {",
