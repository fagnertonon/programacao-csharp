<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Conecta</RootNamespace>
    <AssemblyName>DesafiosCodigo</AssemblyName>

    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- O corretor, a janela e a classe Recado sao os mesmos nas duas
         pastas. Nao ha copia: os dois projetos compilam ../comum. -->
    <Compile Include="..\comum\*.cs" />

    <!-- A VERSAO ENXUTA da fonte unica: so o algoritmo em Portugol, a
         assinatura, a ficha e a dica. SEM RESPOSTA NENHUMA.

         O passos-mural.json inteiro tem as respostas das lacunas e das
         perguntas do outro aplicativo, e ele fica ao lado do executavel -
         qualquer aluno abriria no Bloco de Notas. Por isso este projeto le
         o arquivo magro. -->
    <Content Include="..\..\conteudo\desafios-portugol.json"
             Link="desafios-portugol.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
